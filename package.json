{
  "name": "dsh-tally",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Minimal personal todo list for DeepSeek Harness: in-place editing, due dates, notes, zero runtime dependencies.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "todo",
    "task"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuyuxuan6666/dsh-tally.git"
  },
  "homepage": "https://github.com/liuyuxuan6666/dsh-tally#readme",
  "bugs": {
    "url": "https://github.com/liuyuxuan6666/dsh-tally/issues"
  },
  "author": "lyx6666"
}
